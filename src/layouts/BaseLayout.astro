---
// Base layout for every page: head meta, fonts, tokens, nav slot, footer.
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/tokens.css';
import '../styles/global.css';
import NavPill from '../components/NavPill.astro';
import MenuOverlay from '../components/MenuOverlay.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { features } from '../data/features';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.name, description = site.description } = Astro.props;
---

<!doctype html>
<html lang={site.lang} data-reveals={features.scrollReveals ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#141414" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <!-- Lets CSS show JavaScript-only controls (the Menu button) only when scripts run. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <NavPill />
      <MenuOverlay />
      <slot name="header" />
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <Footer />
      <slot name="footer" />
    </footer>
  </body>
</html>

<script>
  import { initReveals } from '../scripts/reveal';

  // Switched on by `features.scrollReveals` (src/data/features.ts).
  if (document.documentElement.hasAttribute('data-reveals')) initReveals();
</script>

<style>
  main:focus {
    outline: none;
  }
</style>
