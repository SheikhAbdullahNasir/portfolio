---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectStack from '../components/ProjectStack.astro';
import NowCards from '../components/NowCards.astro';
import About from '../components/About.astro';
import BeyondGrid from '../components/BeyondGrid.astro';
import Contact from '../components/Contact.astro';
import { navSections } from '../data/nav';
---

<BaseLayout>
  <Hero />

  {
    navSections.map((section) => (
      <section
        id={section.id}
        class:list={['section', { 'section--work': section.id === 'work' }]}
        aria-labelledby={`${section.id}-heading`}
        tabindex="-1"
      >
        <h2 id={`${section.id}-heading`} class="section__heading">
          {section.label}
        </h2>
        {section.id === 'work' && <ProjectStack />}
        {section.id === 'now' && <NowCards />}
        {section.id === 'about' && <About />}
        {section.id === 'beyond' && <BeyondGrid />}
        {section.id === 'contact' && <Contact />}
      </section>
    ))
  }
</BaseLayout>

<style>
  .section {
    --section-pad: 96px;
    max-width: var(--content-max);
    margin-inline: auto;
    padding: var(--section-pad) var(--gutter);
    border-top: 1px solid var(--line);
    /* Anchor jumps skip the top padding, so the heading lands just below the pill
       (html's scroll-padding-top keeps it clear of the pill). */
    scroll-margin-top: calc(-1 * var(--section-pad));
  }

  /* Mobile: the stack already leaves room for the last card to settle. */
  @media (max-width: 1023px) {
    .section--work {
      padding-bottom: 24px;
    }
  }

  /* Sections take focus when reached from the menu; the ring would outline the whole section. */
  .section:focus {
    outline: none;
  }

  .section__heading {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: var(--weight-extrabold);
  }
</style>
