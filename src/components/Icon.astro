---
// Inline SVG icon from Remix Icon (@iconify-json/ri, Apache 2.0). Read at build
// time only, so no icon code ships to the browser. Decorative by default.
import { icons } from '@iconify-json/ri/icons.json';

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  size?: number;
  /** Accessible name. Leave empty for decorative icons next to visible text. */
  label?: string;
  class?: string;
}

const { name, size = 24, label, class: className } = Astro.props;
const body = icons[name].body;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="currentColor"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={body}
/>
