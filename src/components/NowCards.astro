---
// Now: three cards (Building, Learning, Exploring) with an icon each and a
// "Last updated" line. One column on mobile, three from 768px.
import Icon from './Icon.astro';
import { now } from '../data/now';
---

<div class="now">
  <p class="now__updated" data-reveal>{now.lastUpdatedLabel} {now.lastUpdated}</p>
  <ul class="now__list">
    {
      now.items.map((item) => (
        <li class="now__card" data-reveal>
          <span class="now__icon">
            <Icon name={item.icon} size={22} />
          </span>
          <h3 class="now__label">{item.label}</h3>
          <p class="now__text">{item.text}</p>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .now {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-top: 16px;
  }

  .now__updated {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .now__list {
    display: grid;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .now__card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
  }

  .now__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-bottom: 4px;
    border-radius: 14px;
    background: rgba(143, 179, 255, 0.12);
    color: var(--accent);
  }

  .now__label {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: var(--weight-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .now__text {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: var(--weight-bold);
    line-height: 1.25;
    text-wrap: pretty;
  }

  @media (min-width: 768px) {
    .now__list {
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .now__card {
      padding: 32px;
    }
  }
</style>
