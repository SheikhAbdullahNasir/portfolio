---
// Visible marker for content that is still missing. The text comes from
// src/data/placeholders.ts so it matches docs/CONTENT.md.
import { placeholders, type PlaceholderKey } from '../data/placeholders';

interface Props {
  name: PlaceholderKey;
}

const { name } = Astro.props;
---

<span class="placeholder" data-placeholder={name}>{placeholders[name]}</span>

<style>
  .placeholder {
    display: inline-block;
    padding: 0.1em 0.5em;
    border: 1px dashed var(--accent);
    border-radius: 6px;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.875em;
  }
</style>
